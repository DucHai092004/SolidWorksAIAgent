<UserControl x:Class="SwMateAI.UI.TaskPaneControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="760"
 Background="#0B1220" FontFamily="Segoe UI">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/SwMateAI.UI;component/Localization/Strings.vi-VN.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Bg" Color="#0B1220"/>
  <SolidColorBrush x:Key="Surface" Color="#111C2E"/>
  <SolidColorBrush x:Key="Surface2" Color="#16243A"/>
  <SolidColorBrush x:Key="Border" Color="#26364F"/>
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
  <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="12"/>
   <Setter Property="Margin" Value="10,5"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style x:Key="Input" TargetType="TextBox">
   <Setter Property="Background" Value="#0F172A"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="SelectionBrush" Value="#315EA8"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Background" Value="#1E293B"/>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0F1B2D" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="SW-MATE AI" Foreground="White" FontSize="16" FontWeight="Bold"/>
     <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource LanguageLabel}" Foreground="{StaticResource Muted}" FontSize="8" Margin="2,0,0,2"/>
     <ComboBox x:Name="LanguageCombo" Width="92" Height="25" SelectionChanged="LanguageCombo_SelectionChanged" Background="#16243A" Foreground="White" BorderBrush="{StaticResource Border}" Padding="4,1">
      <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" IsSelected="True"/>
      <ComboBoxItem Content="English" Tag="en-US"/>
     </ComboBox>
    </StackPanel>
    <Border Grid.Column="2" Background="#132238" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding AgentStageColor}"/></Ellipse.Fill></Ellipse>
      <TextBlock Text="{Binding AgentStageDisplay}" Foreground="{StaticResource Text}" FontSize="10" FontWeight="SemiBold"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,5,0,12">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{DynamicResource ContextTitle}" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
         <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnectionColor}"/></Ellipse.Fill></Ellipse>
         <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="10"/>
        </StackPanel>
       </StackPanel>
       <Button Grid.Column="1" Content="↻" Command="{Binding RefreshInfoCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5" ToolTip="{DynamicResource RefreshTooltip}"/>
      </Grid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="{DynamicResource DocumentLabel}" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding DocumentTitle}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding DocumentType}" Foreground="#60A5FA" FontSize="10"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <TextBlock Text="{DynamicResource ConfigurationLabel}" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding ActiveConfiguration}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <Grid Margin="0,0,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{DynamicResource ModelInspectorTitle}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{DynamicResource ModelInspectorDescription}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
       </StackPanel>
       <Button Grid.Column="1" Content="{DynamicResource ReadModel}" Command="{Binding InspectModelCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8">
       <TextBlock Text="{Binding ModelSummary}" Foreground="{StaticResource Text}" FontSize="10" TextWrapping="Wrap"/>
      </Border>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="{DynamicResource AiCommandTitle}" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{DynamicResource AiCommandDescription}" Style="{StaticResource Caption}" Margin="0,3,0,8"/>
      <TextBox Text="{Binding NaturalLanguageCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto"/>
      <Button Content="{DynamicResource RunAgentPlan}" Command="{Binding ExecuteNaturalLanguageCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="{DynamicResource TaskPlanTitle}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{Binding PlanGoal}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{Binding AgentStageDisplay}" Foreground="#60A5FA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding CurrentPlanSteps}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border Width="22" Height="22" CornerRadius="11" Background="#1D4ED8" VerticalAlignment="Top"><TextBlock Text="{Binding Index}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" Margin="7,0,7,0"><TextBlock Text="{Binding SkillName}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Status}" Foreground="#7DD3FC" FontSize="9" HorizontalAlignment="Right"/>
            <TextBlock Text="{DynamicResource VerifiedText}" Foreground="#34D399" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="{DynamicResource LastResultTitle}" Style="{StaticResource SectionTitle}"/>
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
       <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Top"><Ellipse.Fill><SolidColorBrush Color="{Binding ResultColor}"/></Ellipse.Fill></Ellipse>
       <TextBlock Text="{Binding LastResultText}" Foreground="{StaticResource Text}" FontSize="10" TextWrapping="Wrap"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Expander Margin="10,5" Foreground="{StaticResource Text}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
     <Expander.Header>
      <StackPanel><TextBlock Text="{DynamicResource GuideTitle}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{DynamicResource GuideDescription}" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
     </Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <TextBlock Text="{DynamicResource GuideStep1}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/>
      <TextBlock Text="{DynamicResource GuideStep2}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/>
      <TextBlock Text="{DynamicResource GuideStep3}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/>
      <TextBlock Text="{DynamicResource GuideStep4}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/>
      <TextBlock Text="{DynamicResource GuideStep5}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/>
      <TextBlock Text="{DynamicResource GuideStep6}" Foreground="{StaticResource Text}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,8"/>
      <TextBlock Text="{DynamicResource GuideExamples}" Foreground="#7DD3FC" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,3"/>
      <TextBlock Text="{DynamicResource GuideExample1}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,1"/>
      <TextBlock Text="{DynamicResource GuideExample2}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,1"/>
      <TextBlock Text="{DynamicResource GuideExample3}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,1"/>
      <TextBlock Text="{DynamicResource GuideExample4}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,1"/>
      <TextBlock Text="{DynamicResource GuideExample5}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,1,0,7"/>
      <Border Background="#0F172A" CornerRadius="5" Padding="7"><TextBlock Text="{DynamicResource GuideTip}" Foreground="#A5B4FC" FontSize="9" TextWrapping="Wrap"/></Border>
     </StackPanel>
    </Expander>
    <Expander Margin="10,5" Foreground="{StaticResource Text}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
     <Expander.Header>
      <StackPanel><TextBlock Text="{DynamicResource ManualToolsTitle}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{DynamicResource ManualToolsDescription}" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
     </Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="{DynamicResource NewPart}" Command="{Binding CreatePartCommand}" Style="{StaticResource SecondaryButton}"/>
       <Button Grid.Column="2" Content="{DynamicResource CreateSketch}" Command="{Binding CreateSketchCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <TextBlock Text="{DynamicResource RectangleExtrude}" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding RectangleWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding RectangleHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="{DynamicResource CreateRectangle}" Command="{Binding CreateRectangleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding ExtrudeDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      <Button Content="{DynamicResource Extrude}" Command="{Binding ExtrudeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,10"/>
      <TextBlock Text="{DynamicResource HoleCut}" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding CircleDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding CircleX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="4" Text="{Binding CircleY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="{DynamicResource CreateCircle}" Command="{Binding CreateCircleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding CutDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      <Button Content="{DynamicResource CutExtrude}" Command="{Binding CutExtrudeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,10"/>
      <TextBlock Text="{DynamicResource Dimensions}" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <TextBlock Text="{DynamicResource DimensionHint}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding DimensionName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="{DynamicResource DimensionNameTooltip}"/>
       <TextBox Grid.Column="2" Text="{Binding DimensionValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="{DynamicResource DimensionValueTooltip}"/>
      </Grid>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="{DynamicResource AddToSelection}" Command="{Binding AddDimensionCommand}" Style="{StaticResource SecondaryButton}"/>
       <Button Grid.Column="2" Content="{DynamicResource ModifyDimension}" Command="{Binding ModifyDimensionCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <TextBlock Text="{DynamicResource QuickWorkflow}" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding PlateWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding PlateHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="4" Text="{Binding PlateThickness, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding PlateHoleDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding PlateHoleDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="{DynamicResource CreatePlateHole}" Command="{Binding CreatePlateWithHoleCommand}" Style="{StaticResource SecondaryButton}"/>
     </StackPanel>
    </Expander>
    <Expander Margin="10,5" Foreground="{StaticResource Text}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
     <Expander.Header>
      <StackPanel><TextBlock Text="{DynamicResource ActivityHistoryTitle}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{DynamicResource ActivityHistoryDescription}" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
     </Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <TextBlock Text="{DynamicResource RecentCommands}" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
      <Border Background="#0F172A" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="7" MaxHeight="100">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CommandHistory}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Border>
      <TextBlock Text="{DynamicResource AgentConsole}" Style="{StaticResource Caption}" Margin="0,10,0,5"/>
      <Border Background="#080D16" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="7" Height="150">
       <ScrollViewer x:Name="ConsoleScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding ConsoleLog}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#7DD3FC" FontFamily="Consolas" FontSize="9" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
      </Border>
     </StackPanel>
    </Expander>
    <TextBlock Text="{DynamicResource FooterText}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,8,0,4"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
