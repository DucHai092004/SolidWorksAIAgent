<UserControl x:Class="SwMateAI.UI.TaskPaneControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="760"
 Background="#0B1220" FontFamily="Segoe UI">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0B1220"/>
  <SolidColorBrush x:Key="Surface" Color="#111C2E"/>
  <SolidColorBrush x:Key="Surface2" Color="#16243A"/>
  <SolidColorBrush x:Key="Border" Color="#26364F"/>
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
  <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="12"/>
   <Setter Property="Margin" Value="10,5"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style x:Key="Input" TargetType="TextBox">
   <Setter Property="Background" Value="#0F172A"/>
   <Setter Property="Foreground" Value="{StaticResource Text}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="CaretBrush" Value="White"/>
   <Setter Property="SelectionBrush" Value="#315EA8"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Background" Value="#1E293B"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0F1B2D" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="SW-MATE AI" Foreground="White" FontSize="16" FontWeight="Bold"/>
     <TextBlock Text="Mechanical CAD Agent · V1" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Background="#132238" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding AgentStageColor}"/></Ellipse.Fill></Ellipse>
      <TextBlock Text="{Binding AgentStageText}" Foreground="{StaticResource Text}" FontSize="10" FontWeight="SemiBold"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,5,0,12">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="SOLIDWORKS CONTEXT" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
         <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnectionColor}"/></Ellipse.Fill></Ellipse>
         <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="10"/>
        </StackPanel>
       </StackPanel>
       <Button Grid.Column="1" Content="↻" Command="{Binding RefreshInfoCommand}" Style="{StaticResource SecondaryButton}" Padding="9,5"/>
      </Grid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="DOCUMENT" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding DocumentTitle}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding DocumentType}" Foreground="#60A5FA" FontSize="10"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <TextBlock Text="CONFIGURATION" Style="{StaticResource Caption}"/>
        <TextBlock Text="{Binding ActiveConfiguration}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <Grid Margin="0,0,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="MODEL INSPECTOR" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Read actual CAD data from the active model." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
       </StackPanel>
       <Button Grid.Column="1" Content="READ MODEL" Command="{Binding InspectModelCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8">
       <TextBlock Text="{Binding ModelSummary}" Foreground="{StaticResource Text}" FontSize="10" TextWrapping="Wrap"/>
      </Border>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="AI CAD COMMAND" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Describe what you want SW-MATE AI to create or modify." Style="{StaticResource Caption}" Margin="0,3,0,8"/>
      <TextBox Text="{Binding NaturalLanguageCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto"/>
      <Button Content="▶  RUN AGENT PLAN" Command="{Binding ExecuteNaturalLanguageCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="TASK PLAN" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{Binding PlanGoal}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{Binding AgentStageText}" Foreground="#60A5FA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding CurrentPlanSteps}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Border Width="22" Height="22" CornerRadius="11" Background="#1D4ED8" VerticalAlignment="Top"><TextBlock Text="{Binding Index}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" Margin="7,0,7,0"><TextBlock Text="{Binding SkillName}" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap"/></StackPanel>
           <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding Status}" Foreground="#7DD3FC" FontSize="9" HorizontalAlignment="Right"/>
            <TextBlock Text="✓ Verified" Foreground="#34D399" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="LAST RESULT" Style="{StaticResource SectionTitle}"/>
      <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
       <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Top"><Ellipse.Fill><SolidColorBrush Color="{Binding ResultColor}"/></Ellipse.Fill></Ellipse>
       <TextBlock Text="{Binding LastResultText}" Foreground="{StaticResource Text}" FontSize="10" TextWrapping="Wrap"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Expander Margin="10,5" Foreground="{StaticResource Text}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
     <Expander.Header>
      <StackPanel><TextBlock Text="MANUAL CAD TOOLS" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Direct SolidWorks operations for testing and recovery" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
     </Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="New Part" Command="{Binding CreatePartCommand}" Style="{StaticResource SecondaryButton}"/>
       <Button Grid.Column="2" Content="Create Sketch" Command="{Binding CreateSketchCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <TextBlock Text="RECTANGLE + EXTRUDE" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding RectangleWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding RectangleHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="Create Rectangle" Command="{Binding CreateRectangleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding ExtrudeDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      <Button Content="Extrude" Command="{Binding ExtrudeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,10"/>
      <TextBlock Text="HOLE + CUT" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding CircleDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding CircleX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="4" Text="{Binding CircleY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="Create Circle" Command="{Binding CreateCircleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding CutDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      <Button Content="Cut Extrude" Command="{Binding CutExtrudeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,10"/>
      <TextBlock Text="DIMENSIONS" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <TextBlock Text="Select sketch geometry to add, or enter a full dimension name to modify." Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding DimensionName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="Dimension name, e.g. D1@Sketch1. Leave empty to use selected dimension."/>
       <TextBox Grid.Column="2" Text="{Binding DimensionValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" ToolTip="Dimension value in mm"/>
      </Grid>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="Add to Selection" Command="{Binding AddDimensionCommand}" Style="{StaticResource SecondaryButton}"/>
       <Button Grid.Column="2" Content="Modify Dimension" Command="{Binding ModifyDimensionCommand}" Style="{StaticResource SecondaryButton}"/>
      </Grid>
      <TextBlock Text="QUICK WORKFLOW" Style="{StaticResource Caption}" Margin="0,2,0,5"/>
      <Grid Margin="0,0,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding PlateWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding PlateHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="4" Text="{Binding PlateThickness, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBox Grid.Column="0" Text="{Binding PlateHoleDiameter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
       <TextBox Grid.Column="2" Text="{Binding PlateHoleDepth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
      </Grid>
      <Button Content="Create Plate + Hole" Command="{Binding CreatePlateWithHoleCommand}" Style="{StaticResource SecondaryButton}"/>
     </StackPanel>
    </Expander>
    <Expander Margin="10,5" Foreground="{StaticResource Text}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10">
     <Expander.Header>
      <StackPanel><TextBlock Text="ACTIVITY &amp; HISTORY" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Recent commands and agent diagnostics" Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel>
     </Expander.Header>
     <StackPanel Margin="0,10,0,0">
      <TextBlock Text="RECENT COMMANDS" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
      <Border Background="#0F172A" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="7" MaxHeight="100">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CommandHistory}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Border>
      <TextBlock Text="AGENT CONSOLE" Style="{StaticResource Caption}" Margin="0,10,0,5"/>
      <Border Background="#080D16" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="7" Height="150">
       <ScrollViewer x:Name="ConsoleScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding ConsoleLog}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#7DD3FC" FontFamily="Consolas" FontSize="9" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </ScrollViewer>
      </Border>
     </StackPanel>
    </Expander>
    <TextBlock Text="SW-MATE AI  ·  Phase 1 Basic CAD  ·  v0.6.0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,8,0,4"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
