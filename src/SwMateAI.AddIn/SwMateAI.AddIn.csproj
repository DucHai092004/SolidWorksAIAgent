<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>SwMateAI.AddIn</AssemblyName>
    <RootNamespace>SwMateAI.AddIn</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xarial.XCad.SolidWorks" Version="0.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwMateAI.Core\SwMateAI.Core.csproj" />
    <ProjectReference Include="..\SwMateAI.UI\SwMateAI.UI.csproj" />
  </ItemGroup>

  <Target Name="BuildBomWorker" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\SwMateAI.BomWorker.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>

  <Target Name="CopyBomWorker" AfterTargets="Build">
    <ItemGroup>
      <BomWorkerFiles Include="$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\bin\x64\$(Configuration)\net48\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(BomWorkerFiles)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
