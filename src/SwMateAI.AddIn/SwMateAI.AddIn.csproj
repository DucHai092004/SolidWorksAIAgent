<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>SwMateAI.AddIn</AssemblyName>
    <RootNamespace>SwMateAI.AddIn</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>

    <!--
      Disable auto-generated AssemblyInfo.
      Properties\AssemblyInfo.cs handles all assembly attributes manually,
      including [assembly: ComVisible(false)] at assembly level.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- xCAD.NET 0.8.3 — latest stable, supports SOLIDWORKS 2018-2024 -->
  <ItemGroup>
    <PackageReference Include="Xarial.XCad.SolidWorks" Version="0.8.3" />
  </ItemGroup>

  <!-- Project references: AddIn depends on Core/UI. Export workers are separate
       processes and are built as dependencies without being linked into the AddIn. -->
  <ItemGroup>
    <ProjectReference Include="..\SwMateAI.Core\SwMateAI.Core.csproj" />
    <ProjectReference Include="..\SwMateAI.UI\SwMateAI.UI.csproj" />
    <ProjectReference Include="..\SwMateAI.BomWorker\SwMateAI.BomWorker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SwMateAI.StockWorker\SwMateAI.StockWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Each worker gets an isolated runtime folder. The AddIn/xCAD output carries a
    newer SolidWorks.Interop assembly than SOLIDWORKS 2021, while the workers are
    compiled against the local SOLIDWORKS 2021 redist (29.0.0.5028). Keeping each
    worker's complete output together prevents assembly-binding conflicts.
  -->
  <Target Name="CopyExportWorkersToAddInOutput" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <BomWorkerOutputDir>$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\bin\$(Configuration)\net48</BomWorkerOutputDir>
      <StockWorkerOutputDir>$(MSBuildProjectDirectory)\..\SwMateAI.StockWorker\bin\$(Configuration)\net48</StockWorkerOutputDir>
      <BomWorkerDeployDir>$(TargetDir)Workers\Bom</BomWorkerDeployDir>
      <StockWorkerDeployDir>$(TargetDir)Workers\Stock</StockWorkerDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <BomWorkerDeployFiles Include="$(BomWorkerOutputDir)\*.*" />
      <StockWorkerDeployFiles Include="$(StockWorkerOutputDir)\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(BomWorkerDeployDir);$(StockWorkerDeployDir)" />
    <Copy SourceFiles="@(BomWorkerDeployFiles)"
          DestinationFolder="$(BomWorkerDeployDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StockWorkerDeployFiles)"
          DestinationFolder="$(StockWorkerDeployDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
