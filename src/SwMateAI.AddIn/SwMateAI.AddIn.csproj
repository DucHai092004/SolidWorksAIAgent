<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>SwMateAI.AddIn</AssemblyName>
    <RootNamespace>SwMateAI.AddIn</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xarial.XCad.SolidWorks" Version="0.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwMateAI.Core\SwMateAI.Core.csproj" />
    <ProjectReference Include="..\SwMateAI.UI\SwMateAI.UI.csproj" />
  </ItemGroup>

  <Target Name="BuildExtractionWorkers" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\SwMateAI.BomWorker.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\SwMateAI.StockWorker\SwMateAI.StockWorker.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\SwMateAI.DrawingWorker\SwMateAI.DrawingWorker.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>

  <!-- Package worker runtimes before Xarial's AfterBuild/RegAsm step. This keeps
       the package complete even when a non-admin build cannot register COM. -->
  <Target Name="CopyExtractionWorkers" BeforeTargets="AfterBuild">
    <ItemGroup>
      <BomWorkerFiles Include="$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\bin\x64\$(Configuration)\net48\*.*" />
      <StockWorkerFiles Include="$(MSBuildProjectDirectory)\..\SwMateAI.StockWorker\bin\x64\$(Configuration)\net48\*.*" />
      <DrawingWorkerFiles Include="$(MSBuildProjectDirectory)\..\SwMateAI.DrawingWorker\bin\x64\$(Configuration)\net48\*.*" />
    </ItemGroup>

    <MakeDir Directories="$(OutDir)BomWorker" />
    <MakeDir Directories="$(OutDir)StockWorker" />
    <MakeDir Directories="$(OutDir)DrawingWorker" />

    <Copy
      SourceFiles="@(BomWorkerFiles)"
      DestinationFolder="$(OutDir)BomWorker"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(StockWorkerFiles)"
      DestinationFolder="$(OutDir)StockWorker"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(DrawingWorkerFiles)"
      DestinationFolder="$(OutDir)DrawingWorker"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
