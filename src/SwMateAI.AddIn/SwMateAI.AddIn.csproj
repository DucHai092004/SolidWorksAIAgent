<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>SwMateAI.AddIn</AssemblyName>
    <RootNamespace>SwMateAI.AddIn</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>

    <!--
      Disable auto-generated AssemblyInfo.
      Properties\AssemblyInfo.cs handles all assembly attributes manually,
      including [assembly: ComVisible(false)] at assembly level.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- xCAD.NET 0.8.3 — latest stable, supports SOLIDWORKS 2018-2024 -->
  <ItemGroup>
    <PackageReference Include="Xarial.XCad.SolidWorks" Version="0.8.3" />
  </ItemGroup>

  <!-- Project references: AddIn depends on Core/UI. The BOM worker is a separate
       process and is built as a dependency without being linked into the AddIn. -->
  <ItemGroup>
    <ProjectReference Include="..\SwMateAI.Core\SwMateAI.Core.csproj" />
    <ProjectReference Include="..\SwMateAI.UI\SwMateAI.UI.csproj" />
    <ProjectReference Include="..\SwMateAI.BomWorker\SwMateAI.BomWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The export tab locates SwMateAI.BomWorker.exe beside the AddIn assembly.
       Shared Core/OpenXML/Interop dependencies are already in the AddIn output. -->
  <Target Name="CopyBomWorkerToAddInOutput" AfterTargets="Build">
    <PropertyGroup>
      <BomWorkerOutputDir>$(MSBuildProjectDirectory)\..\SwMateAI.BomWorker\bin\$(Platform)\$(Configuration)\net48</BomWorkerOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <BomWorkerDeployFiles Include="$(BomWorkerOutputDir)\SwMateAI.BomWorker.exe" />
      <BomWorkerDeployFiles Include="$(BomWorkerOutputDir)\SwMateAI.BomWorker.exe.config"
                            Condition="Exists('$(BomWorkerOutputDir)\SwMateAI.BomWorker.exe.config')" />
    </ItemGroup>
    <Copy SourceFiles="@(BomWorkerDeployFiles)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
